# Backend URL (no secrets here: anything VITE_* is visible in the browser)
VITE_API_BASE_URL=http://localhost:8000
# Shown in the emergency banner / call button. Must match EMERGENCY_NUMBER in backend/.env
VITE_EMERGENCY_NUMBER=999
# Must be <= MAX_MESSAGE_CHARS in backend/.env
VITE_MAX_MESSAGE_CHARS=1500
# Max wait for one reply (ms). Keep above SERVER_TIMEOUT_SECONDS in backend/.env
VITE_REQUEST_TIMEOUT_MS=200000
