# ============ Which engine answers ============
# server      = a local OpenAI-compatible server such as llama.cpp `llama-server` (use this for Qwen3.5-9B Q4 GGUF)
# local       = Transformers in this process (e.g. google/medgemma-1.5-4b-it; needs requirements-local.txt)
# huggingface = remote Hugging Face Inference Providers (needs credits)
LLM_BACKEND=server

# ---- LLM_BACKEND=server ----
SERVER_BASE_URL=http://127.0.0.1:8080/v1
SERVER_MODEL=qwen3.5-9b
SERVER_DISABLE_THINKING=true
SERVER_MAX_NEW_TOKENS=700
SERVER_TIMEOUT_SECONDS=180

# ---- LLM_BACKEND=local (Transformers) ----
LOCAL_MODEL_ID=google/medgemma-1.5-4b-it

# ---- Hugging Face ----
# Create a token at https://huggingface.co/settings/tokens
# Use a fine-grained token with permission to call Inference Providers.
HF_TOKEN=your_huggingface_token

# Candidate default. Verify it works for YOUR token with:
#   python -m scripts.check_model
HF_MODEL_ID=Qwen/Qwen3-235B-A22B-Instruct-2507

# "auto" lets Hugging Face pick a provider, or name one explicitly (e.g. "novita").
HF_PROVIDER=auto

# ---- Generation limits ----
HF_MAX_NEW_TOKENS=600
HF_TEMPERATURE=0.3
HF_TIMEOUT_SECONDS=45

# ---- Request limits ----
MAX_MESSAGE_CHARS=1500
MAX_HISTORY_MESSAGES=8
MAX_REQUEST_BYTES=262144
RATE_LIMIT=20/minute

# ---- Safety engine ----
# Number shown in emergency messages. 999 = Bangladesh national emergency service.
# CHANGE THIS if you deploy for another country.
EMERGENCY_NUMBER=999

# ---- CORS: comma-separated allowed frontend origins (never "*") ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
